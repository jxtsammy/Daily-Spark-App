{
  "expo": {
    "name": "Daily Spark",
    "slug": "daily-spark",
    "scheme": "dailyspark",
    "version": "2.0.2",
    "orientation": "portrait",
    "icon": "./assets/daily-spark-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/daily-spark-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification",
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": false,
      "bundleIdentifier": "com.ashdev87.dailyspark"
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/daily-spark-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.ashdev87.dailyspark",
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/daily-spark-icon.png"
    },
    "owner": "ashdev87",
    "plugins": [
      "expo-system-ui",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-2192654244363810~8062848807",
          "iosAppId": "ca-app-pub-2192654244363810~8062848807"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/daily-spark-icon.png",
          "color": "#000000",
          "sounds": [],
          "mode": "production"
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "11d03376-e061-44a6-b8f1-7723864b8055"
      }
    }
  }
}